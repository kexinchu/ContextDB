RESET enable_seqscan;
SET enable_seqscan = off;
SET hnsw.ef_search = 32;
SET hnsw.filter_strategy = traversal_guided;
SET hnsw.traversal_guided_prioritization = on;
SET hnsw.traversal_guided_target = 4;
SET hnsw.max_scan_tuples = 50000;
SET hnsw.traversal_guided_min_skip_rate = 0;
CREATE TABLE hnsw_profile_guidance_t (
    id int PRIMARY KEY,
    eligible boolean NOT NULL,
    tags int[] NOT NULL,
    other_tags int[] NOT NULL,
    val vector(2) NOT NULL
);
INSERT INTO hnsw_profile_guidance_t
SELECT i,
       i % 2 = 0,
       CASE i % 3 WHEN 0 THEN ARRAY[23] WHEN 1 THEN ARRAY[29] ELSE ARRAY[31] END,
       CASE i % 2 WHEN 0 THEN ARRAY[23] ELSE ARRAY[31] END,
       ARRAY[
           (((i * 37) % 997)::double precision + i / 100000.0)::real,
           (((i * 97) % 991)::double precision + i / 70000.0)::real
       ]::vector
FROM generate_series(1, 256) AS rows(i);
CREATE INDEX hnsw_profile_guidance_idx
ON hnsw_profile_guidance_t USING hnsw (val vector_l2_ops)
WITH (m = 8, ef_construction = 80);
ANALYZE hnsw_profile_guidance_t;
SET client_min_messages = warning;
SELECT vector_hnsw_fragment_tracking_enable('hnsw_profile_guidance_t'::regclass) IS NOT NULL AS profile_guidance_tracking_enabled;
