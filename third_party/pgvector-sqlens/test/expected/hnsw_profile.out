WITH p AS (
	SELECT vector_hnsw_last_scan_profile()::jsonb AS j
)
SELECT
	(j->>'profile_semantics_version')::int = 12 AS semantics_v12,
	j ? 'index_page_loads' AND j ? 'index_page_runs' AND
	j ? 'index_page_distinct_pages' AND j ? 'index_page_last_block' AS index_fields,
	(j->>'index_page_loads')::bigint >= 0 AND
	(j->>'index_page_runs')::bigint >= 0 AND
	(j->>'index_page_distinct_pages')::bigint >= 0 AS index_nonnegative,
	(j->>'index_page_runs')::bigint <= (j->>'index_page_loads')::bigint AS index_runs_bounded,
	(j->>'index_page_loads')::bigint =
		(j->>'idx_blks_hit')::bigint + (j->>'idx_blks_read')::bigint AS index_buffers_match,
	j ? 'index_readbuffer_calls' AND
	j ? 'index_readbuffer_ms' AND
	j ? 'index_readbuffer_shared_read_calls' AND
	j ? 'index_readbuffer_shared_read_ms' AND
	j ? 'index_readbuffer_shared_hit_calls' AND
	j ? 'index_readbuffer_shared_hit_ms' AND
	j ? 'index_readbuffer_unclassified_calls' AND
	j ? 'index_readbuffer_unclassified_ms' AS readbuffer_fields,
	(j->>'index_readbuffer_calls')::bigint =
		(j->>'index_page_loads')::bigint AND
	(j->>'index_readbuffer_calls')::bigint =
		(j->>'index_readbuffer_shared_read_calls')::bigint +
		(j->>'index_readbuffer_shared_hit_calls')::bigint +
		(j->>'index_readbuffer_unclassified_calls')::bigint AS readbuffer_calls_match,
	(j->>'index_readbuffer_ms')::double precision >= 0 AND
	abs(
		(j->>'index_readbuffer_ms')::double precision -
		(
			(j->>'index_readbuffer_shared_read_ms')::double precision +
			(j->>'index_readbuffer_shared_hit_ms')::double precision +
			(j->>'index_readbuffer_unclassified_ms')::double precision
		)
	) < 0.001 AS readbuffer_time_matches,
	j ? 'distance_compute_timed_calls' AND
	j ? 'distance_compute_ms' AND
	j ? 'hnsw_remaining_ms' AND
	j ? 'profile_timer_overhead_scope' AS distance_time_fields,
	(j->>'distance_compute_timed_calls')::bigint =
		(j->>'distance_compute_count')::bigint AND
	(j->>'distance_compute_ms')::double precision >= 0 AS distance_calls_match,
	abs(
		(j->>'hnsw_am_callback_ms')::double precision -
		(
			(j->>'index_readbuffer_ms')::double precision +
			(j->>'distance_compute_ms')::double precision +
			(j->>'hnsw_remaining_ms')::double precision
		)
	) < 0.001 AS hnsw_breakdown_matches,
	j ? 'index_page_transition_count' AND
	j ? 'index_page_same_block_transitions' AND
	j ? 'index_page_within_1_page_transitions' AND
	j ? 'index_page_within_4_pages_transitions' AND
	j ? 'index_page_within_16_pages_transitions' AND
	j ? 'index_page_backward_transitions' AND
	j ? 'index_page_total_abs_block_delta' AND
	j ? 'index_page_max_abs_block_delta' AND
	j ? 'index_page_trace_sample' AS trace_fields,
	(j->>'index_page_transition_count')::bigint =
		GREATEST((j->>'index_page_loads')::bigint - 1, 0) AS transitions_match_one_scan,
	(j->>'index_page_same_block_transitions')::bigint <=
		(j->>'index_page_within_1_page_transitions')::bigint AND
	(j->>'index_page_within_1_page_transitions')::bigint <=
		(j->>'index_page_within_4_pages_transitions')::bigint AND
	(j->>'index_page_within_4_pages_transitions')::bigint <=
		(j->>'index_page_within_16_pages_transitions')::bigint AND
	(j->>'index_page_within_16_pages_transitions')::bigint <=
		(j->>'index_page_transition_count')::bigint AS transition_counts_bounded,
	(j->>'index_page_trace_sample_count')::bigint =
		LEAST((j->>'index_page_loads')::bigint,
			  (j->>'index_page_trace_sample_limit')::bigint) AND
	jsonb_array_length(j->'index_page_trace_sample') =
		(j->>'index_page_trace_sample_count')::int AS trace_sample_matches,
	j ? 'heap_tid_returns' AND j ? 'heap_tid_page_runs' AND
	j ? 'heap_tid_distinct_pages' AS heap_fields,
	(j->>'heap_tid_returns')::bigint = 4 AND
	(j->>'heap_tid_page_runs')::bigint = 1 AND
	(j->>'heap_tid_distinct_pages')::bigint = 1 AS predictable_heap_runs,
	(j->>'heap_tid_returns')::bigint =
		(j->>'raw_index_tids_returned')::bigint AS heap_returns_match,
	(j->>'heap_blks_are_exact_heap_io')::boolean = false AS heap_io_not_claimed_exact
FROM p;
 semantics_v12 | index_fields | index_nonnegative | index_runs_bounded | index_buffers_match | readbuffer_fields | readbuffer_calls_match | readbuffer_time_matches | distance_time_fields | distance_calls_match | hnsw_breakdown_matches | trace_fields | transitions_match_one_scan | transition_counts_bounded | trace_sample_matches | heap_fields | predictable_heap_runs | heap_returns_match | heap_io_not_claimed_exact 
---------------+--------------+-------------------+--------------------+---------------------+-------------------+------------------------+-------------------------+----------------------+----------------------+------------------------+--------------+----------------------------+---------------------------+----------------------+-------------+-----------------------+--------------------+---------------------------
 t             | t            | t                 | t                  | t                   | t                 | t                      | t                       | t                    | t                    | t                      | t            | t                          | t                         | t                    | t           | t                     | t                  | t
(1 row)

WITH f AS (
	SELECT vector_hnsw_graph_fingerprint('hnsw_profile_t_idx')::jsonb AS j
)
SELECT
	j->>'format' = 'sqlens-hnsw-graph-v3' AS graph_v3,
	(j->>'nodes')::bigint = 8 AND
	(j->>'heap_tids')::bigint = 8 AND
	(j->>'tombstones')::bigint = 0 AS complete_tuple_coverage,
	j#>>'{edge_span,format}' = 'sqlens-hnsw-edge-span-v1' AND
	(j#>>'{edge_span,full_statistics}')::boolean AS edge_span_v1,
	(j#>>'{edge_span,all_layers,directed_edges}')::bigint >=
		(j#>>'{edge_span,level_zero,directed_edges}')::bigint AND
	(j#>>'{edge_span,level_zero,directed_edges}')::bigint > 0 AS edge_counts_complete,
	(j#>>'{edge_span,level_zero,same_page_edges}')::bigint <=
		(j#>>'{edge_span,level_zero,within_1_page_edges}')::bigint AND
	(j#>>'{edge_span,level_zero,within_1_page_edges}')::bigint <=
		(j#>>'{edge_span,level_zero,within_4_pages_edges}')::bigint AND
	(j#>>'{edge_span,level_zero,within_4_pages_edges}')::bigint <=
		(j#>>'{edge_span,level_zero,within_16_pages_edges}')::bigint AND
	(j#>>'{edge_span,level_zero,within_16_pages_edges}')::bigint <=
		(j#>>'{edge_span,level_zero,directed_edges}')::bigint AS edge_bands_bounded,
	(j#>>'{edge_span,level_zero,p50_abs_block_delta}')::bigint <=
		(j#>>'{edge_span,level_zero,p95_abs_block_delta}')::bigint AND
	(j#>>'{edge_span,level_zero,p95_abs_block_delta}')::bigint <=
		(j#>>'{edge_span,level_zero,p99_abs_block_delta}')::bigint AND
	(j#>>'{edge_span,level_zero,p99_abs_block_delta}')::bigint <=
		(j#>>'{edge_span,level_zero,max_abs_block_delta}')::bigint AS edge_percentiles_ordered
FROM f;
 graph_v3 | complete_tuple_coverage | edge_span_v1 | edge_counts_complete | edge_bands_bounded | edge_percentiles_ordered 
