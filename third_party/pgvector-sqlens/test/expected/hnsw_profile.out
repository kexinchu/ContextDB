DO $$
DECLARE
	guide_profile jsonb;
	scan_profile jsonb;
	rows_found bigint;
BEGIN
	PERFORM vector_hnsw_guidance_reset();
	PERFORM vector_hnsw_guidance_activate(
		'hnsw_profile_guidance_idx'::regclass,
		ARRAY['exact:sql:tags @> ARRAY[23]::int[]', '|',
			  'exact:sql:tags @> ARRAY[29]::int[]'],
		'exact');
	SELECT count(*) INTO rows_found
	FROM (
		SELECT id FROM hnsw_profile_guidance_t
		WHERE (SELECT vector_hnsw_guidance_bind(
			'hnsw_profile_guidance_idx'::regclass,
			ARRAY['exact:sql:tags @> ARRAY[23]::int[]', '|',
				  'exact:sql:tags @> ARRAY[29]::int[]'],
			'exact') OFFSET 0)
		  AND tags && ARRAY[23,29]::int[]
		ORDER BY val <-> '[400,400]'::vector
		LIMIT 10
	) AS overlap_rows;
	SELECT vector_hnsw_guidance_profile()::jsonb INTO guide_profile;
	SELECT vector_hnsw_last_scan_profile()::jsonb INTO scan_profile;
	IF rows_found = 0 OR
	   guide_profile->>'planner_proof_bypass_reason' <> 'none' OR
	   NOT (scan_profile->>'planner_proof_succeeded')::boolean OR
	   (scan_profile->>'guidance_checks')::bigint <= 0 THEN
		RAISE EXCEPTION 'int4 overlap equivalence proof failed: guide %, scan %',
			guide_profile, scan_profile;
	END IF;
END $$;
DO $$
DECLARE
	guide_profile jsonb;
	scan_profile jsonb;
BEGIN
	PERFORM vector_hnsw_guidance_reset();
	PERFORM vector_hnsw_guidance_activate(
		'hnsw_profile_guidance_idx'::regclass,
		ARRAY['exact:sql:tags @> ARRAY[23]::int[]'],
		'exact');
	PERFORM id FROM hnsw_profile_guidance_t
	WHERE (SELECT vector_hnsw_guidance_bind(
		'hnsw_profile_guidance_idx'::regclass,
		ARRAY['exact:sql:tags @> ARRAY[23]::int[]'],
		'exact') OFFSET 0)
	  AND tags && ARRAY[23,29]::int[]
	ORDER BY val <-> '[400,400]'::vector
	LIMIT 10;
	SELECT vector_hnsw_guidance_profile()::jsonb INTO guide_profile;
	SELECT vector_hnsw_last_scan_profile()::jsonb INTO scan_profile;
	IF guide_profile->>'planner_proof_bypass_reason' <> 'predicate_not_implied' OR
	   scan_profile->>'final_path' <> 'stock_bypass' OR
	   (scan_profile->>'guidance_checks')::bigint <> 0 THEN
		RAISE EXCEPTION 'incomplete overlap guide did not fail open: guide %, scan %',
			guide_profile, scan_profile;
	END IF;
END $$;
DO $$
DECLARE
	guide_profile jsonb;
	scan_profile jsonb;
BEGIN
	PERFORM vector_hnsw_guidance_reset();
	PERFORM vector_hnsw_guidance_activate(
		'hnsw_profile_guidance_idx'::regclass,
		ARRAY['exact:sql:tags @> ARRAY[23]::int[]', '|',
			  'exact:sql:tags @> ARRAY[29]::int[]'],
		'exact');
	PERFORM id FROM hnsw_profile_guidance_t
	WHERE (SELECT vector_hnsw_guidance_bind(
		'hnsw_profile_guidance_idx'::regclass,
		ARRAY['exact:sql:tags @> ARRAY[23]::int[]', '|',
			  'exact:sql:tags @> ARRAY[29]::int[]'],
		'exact') OFFSET 0)
	  AND other_tags && ARRAY[23,29]::int[]
	ORDER BY val <-> '[400,400]'::vector
	LIMIT 10;
	SELECT vector_hnsw_guidance_profile()::jsonb INTO guide_profile;
	SELECT vector_hnsw_last_scan_profile()::jsonb INTO scan_profile;
	IF guide_profile->>'planner_proof_bypass_reason' <> 'predicate_not_implied' OR
	   scan_profile->>'final_path' <> 'stock_bypass' THEN
		RAISE EXCEPTION 'different-column overlap guide did not fail open: guide %, scan %',
			guide_profile, scan_profile;
	END IF;
END $$;
DO $$
DECLARE
	guide_profile jsonb;
	scan_profile jsonb;
BEGIN
	PERFORM vector_hnsw_guidance_reset();
	PERFORM vector_hnsw_guidance_activate(
		'hnsw_profile_guidance_idx'::regclass,
		ARRAY['exact:sql:tags @> ARRAY[23,29]::int[]'],
		'exact');
	PERFORM id FROM hnsw_profile_guidance_t
	WHERE (SELECT vector_hnsw_guidance_bind(
		'hnsw_profile_guidance_idx'::regclass,
		ARRAY['exact:sql:tags @> ARRAY[23,29]::int[]'],
		'exact') OFFSET 0)
	  AND tags && ARRAY[23,29]::int[]
	ORDER BY val <-> '[400,400]'::vector
	LIMIT 10;
	SELECT vector_hnsw_guidance_profile()::jsonb INTO guide_profile;
	SELECT vector_hnsw_last_scan_profile()::jsonb INTO scan_profile;
	IF guide_profile->>'planner_proof_bypass_reason' <> 'predicate_not_implied' OR
	   scan_profile->>'final_path' <> 'stock_bypass' THEN
		RAISE EXCEPTION 'non-singleton overlap guide did not fail open: guide %, scan %',
			guide_profile, scan_profile;
	END IF;
END $$;
